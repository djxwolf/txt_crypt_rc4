{
    "cmake.configureOnOpen": true,
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.defaultVariants": {
        "buildType": "Debug"
    },
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.preferredGenerators": [
        "Unix Makefiles"
    ],
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "cmake.environment": {
        "CMAKE_CXX_FLAGS": "-I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/c++/v1"
    },
    "cmake.configureArgs": [
        "-DCMAKE_CXX_FLAGS=-I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/c++/v1"
    ],
    "files.associations": {
        "*.h": "cpp",
        "QLineEdit": "cpp",
        "QPushButton": "cpp",
        "QCheckBox": "cpp",
        "QSpinBox": "cpp",
        "QProgressBar": "cpp",
        "QTextEdit": "cpp",
        "QLabel": "cpp",
        "QStatusBar": "cpp",
        "QMainWindow": "cpp",
        "QVBoxLayout": "cpp",
        "QHBoxLayout": "cpp",
        "QGridLayout": "cpp",
        "QGroupBox": "cpp",
        "QFileDialog": "cpp",
        "QMessageBox": "cpp",
        "QFile": "cpp",
        "QTextStream": "cpp",
        "QString": "cpp",
        "QByteArray": "cpp",
        "QDir": "cpp",
        "QFileInfo": "cpp",
        "QDateTime": "cpp",
        "QSignalBlocker": "cpp",
        "QRegularExpression": "cpp"
    }
}
