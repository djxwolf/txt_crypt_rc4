{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "args": ["-C", "build", "-j4"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make",
            "args": ["-C", "build", "clean"],
            "problemMatcher": []
        },
        {
            "label": "run",
            "type": "shell",
            "command": "${workspaceFolder}/build/TxtCryptRC4",
            "dependsOn": ["build"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "test",
            "type": "shell",
            "command": "${workspaceFolder}/build/tests/txt_crypt_rc4_tests",
            "dependsOn": ["build"],
            "problemMatcher": []
        },
        {
            "label": "rebuild",
            "type": "shell",
            "command": "rm -rf build && mkdir build && cd build && cmake .. && make -j4",
            "problemMatcher": ["$gcc"]
        }
    ]
}
